{
  "name": "la-cancha-del-profe-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-instagram-assets.mjs",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "verify:runtime": "node scripts/verify-runtime-imports.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:entrypoint": "node scripts/smoke-entrypoint.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:league": "tsx prisma/seed-league.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "@resvg/resvg-js": "^2.6.2",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.2",
    "jszip": "^3.10.1",
    "luxon": "3.6.1",
    "prisma": "6.8.2",
    "satori": "^0.29.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/jsonwebtoken": "9.0.9",
    "@types/luxon": "3.6.2",
    "@types/node": "22.15.21",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
