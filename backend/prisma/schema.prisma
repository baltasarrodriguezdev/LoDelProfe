generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
  CLIENT
  ADMIN
  SUPERADMIN
}
enum UserStatus {
  PENDING_VERIFICATION
  VERIFIED
}
enum PhoneVerificationMethod {
  WHATSAPP_MANUAL
  PHONE_CALL
  IN_PERSON
}
enum PasswordResetStatus {
  PENDING
  AUTHORIZED
  USED
  CANCELLED
  EXPIRED
}
enum BookingStatus {
  PENDING
  CONFIRMED
  PLAYED
  CANCELLED
  NO_SHOW
  BLOCKED
}
enum BookingOrigin {
  WEB
  WHATSAPP
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
}
enum CashType {
  INCOME
  EXPENSE
}
enum CashCategory {
  TURNO
  BEBIDAS
  COMIDA
  PELOTAS
  LUZ
  AGUA
  MANTENIMIENTO
  LIMPIEZA
  OTRO
}

enum LeagueSeasonStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum LeagueStage {
  GROUP_STAGE
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  FINAL
}

enum LeagueMatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  RESCHEDULED
  SUSPENDED
  PENDING
}

enum LeagueBracketSlot {
  HOME
  AWAY
}
model User {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  phone String @unique
  passwordHash String
  role Role @default(CLIENT)
  active Boolean @default(true)
  phoneVerified Boolean @default(false)
  status UserStatus @default(PENDING_VERIFICATION)
  isBlocked Boolean @default(false)
  verificationCode String? @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?
  phoneVerifiedById Int?
  phoneVerificationMethod PhoneVerificationMethod?
  securityVersion Int @default(0)
  releasedAt DateTime?
  passwordResetRequests PasswordResetRequest[]
  bookings Booking[]
  recurring RecurringBooking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}
model PasswordResetRequest {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  status PasswordResetStatus @default(PENDING)
  tokenHash String? @unique @db.Char(64)
  requestedAt DateTime @default(now())
  authorizedAt DateTime?
  authorizedById Int?
  expiresAt DateTime?
  usedAt DateTime?
  cancelledAt DateTime?
  @@index([status,requestedAt])
  @@index([userId,status])
  @@map("password_reset_requests")
}
model Court {
  id Int @id @default(autoincrement())
  name String
  description String? @db.Text
  active Boolean @default(true)
  bookings Booking[]
  recurring RecurringBooking[]
  leagueSeasons LeagueSeason[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("courts")
}

model LeagueSeason {
  id Int @id @default(autoincrement())
  slug String @unique @db.VarChar(80)
  name String @db.VarChar(120)
  seasonYear Int
  status LeagueSeasonStatus @default(DRAFT)
  currentStage LeagueStage @default(GROUP_STAGE)
  courtId Int?
  court Court? @relation(fields: [courtId], references: [id])
  timezone String @default("America/Argentina/Cordoba") @db.VarChar(80)
  bestOfSets Int @default(3)
  fullThirdSet Boolean @default(true)
  allPairsAdvance Boolean @default(true)
  registrationFee Decimal? @db.Decimal(12,2)
  firstPrize String? @db.VarChar(255)
  secondPrize String? @db.VarChar(255)
  ballAvailabilityNote String? @db.VarChar(255)
  scheduleNote String? @db.Text
  activeFrom DateTime? @db.Date
  activeUntil DateTime? @db.Date
  zones LeagueZone[]
  players LeaguePlayer[]
  pairs LeaguePair[]
  matches LeagueMatch[]
  rules LeagueRuleSettings?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, seasonYear])
  @@map("league_seasons")
}

model LeagueZone {
  id Int @id @default(autoincrement())
  leagueId Int
  league LeagueSeason @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  code String @db.VarChar(8)
  name String @db.VarChar(80)
  regularDay String? @db.VarChar(30)
  displayOrder Int @default(0)
  pairs LeaguePair[]
  matches LeagueMatch[]
  @@unique([leagueId, code])
  @@index([leagueId, displayOrder])
  @@map("league_zones")
}

model LeaguePlayer {
  id Int @id @default(autoincrement())
  leagueId Int
  league LeagueSeason @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  displayName String @db.VarChar(120)
  pairsAsFirst LeaguePair[] @relation("LeaguePairFirstPlayer")
  pairsAsSecond LeaguePair[] @relation("LeaguePairSecondPlayer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([leagueId, displayName])
  @@map("league_players")
}

model LeaguePair {
  id Int @id @default(autoincrement())
  leagueId Int
  league LeagueSeason @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  zoneId Int
  zone LeagueZone @relation(fields: [zoneId], references: [id])
  seedNumber Int
  displayName String @db.VarChar(255)
  firstPlayerId Int
  firstPlayer LeaguePlayer @relation("LeaguePairFirstPlayer", fields: [firstPlayerId], references: [id])
  secondPlayerId Int
  secondPlayer LeaguePlayer @relation("LeaguePairSecondPlayer", fields: [secondPlayerId], references: [id])
  active Boolean @default(true)
  homeMatches LeagueMatch[] @relation("LeagueHomePair")
  awayMatches LeagueMatch[] @relation("LeagueAwayPair")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([leagueId, displayName])
  @@unique([zoneId, seedNumber])
  @@index([leagueId, zoneId])
  @@map("league_pairs")
}

model LeagueRuleSettings {
  id Int @id @default(autoincrement())
  leagueId Int @unique
  league LeagueSeason @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  straightSetsWinPoints Int @default(3)
  threeSetsWinPoints Int @default(2)
  threeSetsLossPoints Int @default(1)
  straightSetsLossPoints Int?
  gamesPositiveDefinition String? @db.Text
  multiPairTieRule String? @db.Text
  walkoverRule String? @db.Text
  retirementRule String? @db.Text
  incompleteMatchRule String? @db.Text
  reschedulingRule String? @db.Text
  sixAllTiebreakRule String? @db.Text
  updatedById Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("league_rule_settings")
}

model LeagueMatch {
  id Int @id @default(autoincrement())
  leagueId Int
  league LeagueSeason @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  zoneId Int?
  zone LeagueZone? @relation(fields: [zoneId], references: [id])
  stage LeagueStage
  matchday Int?
  code String @db.VarChar(30)
  scheduledDate DateTime? @db.Date
  scheduledTime String? @db.VarChar(5)
  status LeagueMatchStatus @default(SCHEDULED)
  homePairId Int?
  homePair LeaguePair? @relation("LeagueHomePair", fields: [homePairId], references: [id])
  awayPairId Int?
  awayPair LeaguePair? @relation("LeagueAwayPair", fields: [awayPairId], references: [id])
  homePlaceholder String? @db.VarChar(120)
  awayPlaceholder String? @db.VarChar(120)
  official Boolean @default(false)
  officialAt DateTime?
  rescheduleNote String? @db.Text
  nextMatchId Int?
  nextMatch LeagueMatch? @relation("LeagueProgression", fields: [nextMatchId], references: [id])
  previousMatches LeagueMatch[] @relation("LeagueProgression")
  nextSlot LeagueBracketSlot?
  sets LeagueMatchSet[]
  updatedById Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([leagueId, code])
  @@index([leagueId, stage, scheduledDate])
  @@index([zoneId, matchday])
  @@map("league_matches")
}

model LeagueMatchSet {
  id Int @id @default(autoincrement())
  matchId Int
  match LeagueMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber Int
  homeGames Int
  awayGames Int
  @@unique([matchId, setNumber])
  @@map("league_match_sets")
}
model Price {
  id Int @id @default(autoincrement())
  durationMinutes Int @unique
  price Decimal @db.Decimal(10,2)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("prices")
}
model BusinessHour {
  id Int @id @default(autoincrement())
  dayOfWeek Int @unique
  openTime String @db.VarChar(5)
  closeTime String @db.VarChar(5)
  breakStartTime String? @db.VarChar(5)
  breakEndTime String? @db.VarChar(5)
  active Boolean @default(true)
  @@map("business_hours")
}
model Booking {
  id Int @id @default(autoincrement())
  courtId Int
  court Court @relation(fields:[courtId],references:[id])
  userId Int?
  user User? @relation(fields:[userId],references:[id])
  recurringId Int?
  recurring RecurringBooking? @relation(fields:[recurringId],references:[id])
  clientName String
  clientPhone String
  startTime DateTime
  endTime DateTime
  durationMinutes Int
  playersCount Int @default(4)
  priceTotal Decimal @db.Decimal(10,2)
  status BookingStatus @default(CONFIRMED)
  origin BookingOrigin @default(WEB)
  paymentStatus PaymentStatus @default(PENDING)
  amountPaid Decimal @default(0) @db.Decimal(10,2)
  paymentMethod String?
  notes String? @db.Text
  holdExpiresAt DateTime?
  cancelledAt DateTime?
  cancellationReason String? @db.Text
  createdBy Int
  cashMovements CashMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([courtId,startTime,endTime])
  @@index([userId,startTime])
  @@index([status,holdExpiresAt])
  @@map("bookings")
}

model VenueSetting {
  id Int @id @default(1)
  cancellationCutoffMinutes Int @default(120)
  updatedAt DateTime @updatedAt
  @@map("venue_settings")
}

model AuditLog {
  id BigInt @id @default(autoincrement())
  actorId Int?
  action String @db.VarChar(80)
  entityType String @db.VarChar(50)
  entityId String? @db.VarChar(50)
  details Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entityType,entityId])
  @@map("audit_logs")
}
model RecurringBooking {
  id Int @id @default(autoincrement())
  courtId Int
  court Court @relation(fields:[courtId],references:[id])
  userId Int?
  user User? @relation(fields:[userId],references:[id])
  clientName String
  clientPhone String
  dayOfWeek Int
  startTime String @db.VarChar(5)
  durationMinutes Int
  priceTotal Decimal @db.Decimal(10,2)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  active Boolean @default(true)
  notes String? @db.Text
  createdBy Int
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("recurring_bookings")
}
model CashMovement {
  id Int @id @default(autoincrement())
  type CashType
  category CashCategory
  amount Decimal @db.Decimal(10,2)
  description String
  bookingId Int?
  booking Booking? @relation(fields:[bookingId],references:[id])
  createdBy Int
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("cash_movements")
}

