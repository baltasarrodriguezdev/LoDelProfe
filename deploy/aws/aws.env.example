# Copiar como deploy/aws/aws.env en EC2 y aplicar: chmod 600 deploy/aws/aws.env
# Este archivo contiene solo placeholders; no reemplazarlo con secretos reales en Git.

BACKEND_IMAGE=000000000000.dkr.ecr.us-east-1.amazonaws.com/lodelprofe-backend:REPLACE_WITH_IMMUTABLE_TAG

MYSQL_DATABASE=la_cancha_del_profe
MYSQL_USER=padel
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD
DATABASE_URL=mysql://padel:REPLACE_WITH_URL_ENCODED_PASSWORD@mysql:3306/la_cancha_del_profe

JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_BYTES
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=padel_session
AUTH_COOKIE_MAX_AGE_MS=604800000
PASSWORD_RESET_TTL_MINUTES=15

BUSINESS_WHATSAPP_PHONE=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
