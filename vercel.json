{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular",
      "installCommand": "npm ci --include=dev --include=optional",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/frontend/browser"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "npm ci --include=dev --include=optional",
      "buildCommand": "npm run prisma:deploy && npm run build && npm run verify:runtime"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google.com https://maps.gstatic.com; font-src 'self' data:; connect-src 'self' wss://lodelprofe.com.ar wss://www.lodelprofe.com.ar wss://lodelprofe.com wss://www.lodelprofe.com wss://*.vercel.app; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
